# Are.na Personal Access Token
# Required for private channels (like gently-carved-website).
#
# 1. Go to https://www.are.na/settings/personal-access-tokens
# 2. Create a token with "read" scope
# 3. Copy this file to .env and paste your token below
#
VITE_ARENA_TOKEN=your_token_here

# Supabase — powers visitor image uploads (the "+" button).
# Leave these blank to hide the upload button entirely.
#
# 1. Create a free project at https://supabase.com
# 2. Project Settings → API: copy the Project URL and the "anon / public" key
# 3. Storage → create a PUBLIC bucket named exactly: uploads
# 4. Run the SQL in the setup notes to allow anonymous upload + list
# 5. Paste the two values below (the anon key is safe to expose publicly)
#
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
